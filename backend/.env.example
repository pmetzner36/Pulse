# App settings
DEBUG=true

# Database — use PostgreSQL in production (Railway provides DATABASE_URL)
DATABASE_URL=sqlite+aiosqlite:///./pulse.db

# JWT — generate a strong random secret for production
JWT_SECRET_KEY=your-super-secret-key-change-this

# Apple Sign In (from Apple Developer Portal)
APPLE_TEAM_ID=
APPLE_CLIENT_ID=Pulse-Mood-Map.Pulse
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# OpenAI (for content moderation)
OPENAI_API_KEY=

# CORS — comma-separated allowed origins (use * for dev)
ALLOWED_ORIGINS=*

# --- PRODUCTION (Railway sets DATABASE_URL automatically) ---
# DEBUG=false
# JWT_SECRET_KEY=<generate-a-strong-random-secret>
# ALLOWED_ORIGINS=https://your-app.com
